{
  "name": "coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI-powered personal coach and todo management app",
  "author": "rjwalters",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "pages:dev": "wrangler pages dev --compatibility-date=2024-01-01 -- npm run dev",
    "pages:deploy": "npm run build && wrangler pages deploy ./dist",
    "pages:deploy:prod": "npm run build && wrangler pages deploy ./dist --branch=main",
    "db:create": "wrangler d1 create coach-db",
    "db:create:prod": "wrangler d1 create coach-db-prod",
    "db:local": "wrangler d1 execute coach-db --local --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute coach-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute coach-db --remote --file=./schema.sql",
    "db:migrate:prod": "wrangler d1 execute coach-db --remote --file=./schema.sql",
    "db:backup:local": "wrangler d1 export coach-db --local --output=./backups/backup-$(date +%Y%m%d-%H%M%S).sql",
    "db:backup:remote": "wrangler d1 export coach-db --remote --output=./backups/backup-$(date +%Y%m%d-%H%M%S).sql",
    "db:console:local": "wrangler d1 execute coach-db --local --command='SELECT * FROM users; SELECT * FROM todos;'",
    "db:console:remote": "wrangler d1 execute coach-db --remote --command='SELECT * FROM users; SELECT * FROM todos;'",
    "wrangler:login": "wrangler login",
    "wrangler:whoami": "wrangler whoami",
    "deploy": "npm run build && npm run db:migrate:remote && npm run pages:deploy:prod"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.2",
    "vite": "^5.4.11",
    "wrangler": "^3.90.0"
  }
}
